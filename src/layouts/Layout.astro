---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  pageUrl?: string;
  ogImage?: string;
  eventLabel?: string;
  noAutoOpen?: boolean;
  /** לא לאנדקס בגוגל. הדף נשאר חי וניתן לשליחה בקישור ישיר. */
  noindex?: boolean;
}

const {
  title = 'Mazeget — מצגות לאירועים משפחתיים',
  description = 'Mazeget מתמחה במצגות וידאו מרגשות לאירועים משפחתיים — בר מצווה, בת מצווה, ימי הולדת וחתונות.',
  pageUrl,
  ogImage = 'https://mazeget.com/logo.png',
  eventLabel,
  noAutoOpen = false,
  noindex = false
} = Astro.props;

const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = `https://mazeget.com${canonicalPath}`;

let rankMathHead = '';
if (pageUrl) {
  try {
    const res = await fetch(`https://wp.mazeget.com/wp-json/rankmath/v1/getHead?url=${encodeURIComponent(pageUrl)}`);
    const data = await res.json();
    // wp.mazeget.com הוא ה"מטבח" — הוא מוגדר noindex בכוונה, וזה נכון.
    // אבל Rank Math מחזיר את ה-head של עמוד הוורדפרס, כולל אותו noindex,
    // וההזרקה שלו לעמוד הציבורי אמרה לגוגל לא לאנדקס מאמרים אמיתיים.
    // מסירים כאן את הנחיית ה-robots; מי שמחליט עליה הוא ה-Layout בלבד.
    // og:url מגיע משם גם הוא ומצביע על wp.mazeget.com — מה שגורם לתצוגה
    // המקדימה בוואטסאפ/פייסבוק להצביע על המטבח במקום על העמוד הציבורי.
    // מפנים אותו לכתובת הקנונית. תמונות ה-og נשארות בוורדפרס, שם מקומן.
    if (data.success) rankMathHead = String(data.head)
      .replace(/<meta[^>]+name=["']robots["'][^>]*>\s*/gi, '')
      .replace(/(<meta[^>]+property=["']og:url["'][^>]+content=["'])[^"']*(["'])/gi, `$1${canonicalUrl}$2`);
  } catch (e) {
    // אם ה-API לא זמין — ממשיכים בלי SEO
  }
}
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!rankMathHead && <meta name="description" content={description} />}
    {!rankMathHead && <meta property="og:title" content={title} />}
    {!rankMathHead && <meta property="og:description" content={description} />}
    {!rankMathHead && <meta property="og:type" content="website" />}
    {!rankMathHead && <meta property="og:url" content={canonicalUrl} />}
    {!rankMathHead && <meta property="og:image" content={ogImage} />}
    {!rankMathHead && <meta property="og:locale" content="he_IL" />}
    {!rankMathHead && <meta property="og:site_name" content="Mazeget" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {rankMathHead && <Fragment set:html={rankMathHead} />}
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Mazeget — מצגות וידאו לאירועים",
      "alternateName": "ניצן שמיר מצגות",
      "url": "https://mazeget.com",
      "logo": "https://mazeget.com/logo.png",
      "image": "https://mazeget.com/logo.png",
      "description": "מצגות וידאו מרגשות לאירועים משפחתיים — בר מצווה, בת מצווה, ימי הולדת וחתונות. עריכה מקצועית, מוזיקה, AI ואפקטים.",
      "telephone": "+972526780531",
      "email": "nizan.shamir@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "רחוב הנדיב 3",
        "addressLocality": "הרצליה",
        "addressRegion": "מרכז",
        "addressCountry": "IL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 32.1676,
        "longitude": 34.8378
      },
      "areaServed": {"@type": "Country", "name": "Israel"},
      "priceRange": "₪₪",
      "currenciesAccepted": "ILS",
      "inLanguage": "he",
      "openingHours": "Mo-Su 09:00-22:00",
      "sameAs": ["https://wa.me/972526780531"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "מצגות וידאו לאירועים",
        "itemListElement": [
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "מצגת לבר מצווה"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "מצגת לבת מצווה"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "מצגת ליום הולדת"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "מצגת לחתונה"}}
        ]
      }
    }
    </script>
    <slot name="head" />
    <script is:inline src="https://cdn.enable.co.il/licenses/enable-L5455408pnr0a7zo-0326-80839/init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Secular+One&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Animated mesh background -->
    <div class="mesh-bg">
      <div class="mesh-orb mesh-orb-1"></div>
      <div class="mesh-orb mesh-orb-2"></div>
      <div class="mesh-orb mesh-orb-3"></div>
      <div class="mesh-orb mesh-orb-4"></div>
    </div>

    <div style="position:relative; z-index:1;">
      <slot />
    </div>

    <Footer />

    <WhatsAppWidget eventLabel={eventLabel} noAutoOpen={noAutoOpen} />
    <Analytics />

    <script>
      // Nav shadow on scroll
      const nav = document.getElementById('main-nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        }, { passive: true });
      }
    </script>

    <script is:inline>
      // לחיצה על סרטון (שמתארח אצלנו) עוצרת/ממשיכה אותו.
      // מדלגים על סרטונים בתוך קישור (תמונות ממוזערות בגלריה — לחיצה עליהן פותחת דף)
      // ועל נגני Vimeo (iframe) שיש להם נגן משלהם.
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('video').forEach(function (video) {
          if (video.closest('a')) return;
          video.style.cursor = 'pointer';
          video.addEventListener('click', function (e) {
            if (e.target !== video) return;
            if (video.paused) { video.play(); } else { video.pause(); }
          });
        });
      });
    </script>
  </body>
</html>
