---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import postsData from '../../data/posts.json';

const PAGE_SIZE = 12;
const NEW_COUNT = 5;

const stripTags = (html: string) => (html ?? '').replace(/<[^>]*>/g, '');

// WordPress stores &#8211; / &quot; / &hellip; — decode them, since Astro
// escapes text output (the old client-side innerHTML decoded them for free)
const decodeEntities = (s: string) => (s ?? '')
  .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
  .replace(/&#x([0-9a-fA-F]+);/g, (_, h) => String.fromCodePoint(parseInt(h, 16)))
  .replace(/&nbsp;/g, ' ')
  .replace(/&hellip;/g, '…')
  .replace(/&quot;/g, '"')
  .replace(/&apos;/g, "'")
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

const clean = (html: string) => decodeEntities(stripTags(html));

const posts = (postsData as any[]).map(p => ({
  id: p.id,
  slug: decodeURIComponent(p.slug),
  title: clean(p.title?.rendered),
  excerpt: clean(p.excerpt?.rendered).trim().substring(0, 120),
  date: p.date,
  dateLabel: new Date(p.date).toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' }),
  categories: p.categories ?? [],
  image: p._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? null,
}));

// The 5 newest posts power the "✨ חדש" filter — resolved at build time
const newestIds = new Set(
  [...posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, NEW_COUNT).map(p => p.id)
);

// Build category map: id → name, keeping only categories actually in use
const catMap: Record<number, string> = {};
for (const p of postsData as any[]) {
  for (const t of p._embedded?.['wp:term']?.[0] ?? []) {
    if (t.id && t.name) catMap[t.id] = t.name;
  }
}
const usedCatIds = new Set(posts.flatMap(p => p.categories.map(Number)));
const categories = Object.entries(catMap).filter(([id]) => usedCatIds.has(Number(id)));
---

<Layout
  title="מדריכים וטיפים על מצגות וידאו לאירועים בישראל"
  description="מאמרים וטיפים על מצגות וידאו לאירועים — כל מה שצריך לדעת על הזמנת מצגת מקצועית לבר מצווה, בת מצווה, ימי הולדת וחתונות."
  noAutoOpen={true}
  pageUrl="https://mazeget.com/מאמרים"
>
  <Header />

  <!-- Hero -->
  <section class="py-10 px-6 text-center" style="background: linear-gradient(135deg, #12023C 0%, #6C22FF 100%);">
    <p class="text-[#E879F9] text-sm font-semibold uppercase tracking-widest mb-2">הבלוג שלנו</p>
    <h1 class="text-4xl md:text-5xl text-white font-black mb-3 leading-tight" style="font-family: 'Secular One', sans-serif;">מאמרים וטיפים</h1>
    <p class="text-white/75 text-base max-w-md mx-auto">כל מה שצריך לדעת על מצגות וידאו לאירועים</p>
  </section>

  <!-- Intro text for SEO -->
  <section class="py-10 px-6 bg-white">
    <div class="max-w-3xl mx-auto text-right">
      <p class="text-gray-600 text-lg leading-relaxed mb-4">
        מצגת וידאו טובה מתחילה הרבה לפני שמפעילים את הוידאו — היא מתחילה בהחלטות נכונות: אילו תמונות לבחור, איך לספר את הסיפור, מה לשלב מ-AI ומה להשאיר רגוע. כאן תמצאו מאמרים וטיפים מהניסיון הישיר שלנו עם מאות מצגות לבר מצווה, בת מצווה, ימי הולדת וחתונות.
      </p>
      <p class="text-gray-500 text-base leading-relaxed">
        הטיפים כאן מבוססים על מה שאנחנו רואים כל יום — מה עובד, מה מרגש, ומה גורם לאולם לעצור נשימה. קריאה מהנה.
      </p>
    </div>
  </section>

  <!-- Category Filter -->
  {categories.length > 0 && (
    <section id="cat-filter" class="py-5 px-6 bg-white border-b border-gray-100 sticky top-0 z-10">
      <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-2" id="cat-buttons">
        <button data-cat="all" class="px-4 py-1.5 rounded-full border font-semibold text-sm transition-all cat-btn-active">הכל</button>
        <button data-cat="new" class="px-4 py-1.5 rounded-full border font-semibold text-sm transition-all cat-btn-inactive">✨ חדש</button>
        {categories.map(([id, name]) => (
          <button data-cat={id} class="px-4 py-1.5 rounded-full border font-semibold text-sm transition-all cat-btn-inactive">{name}</button>
        ))}
      </div>
    </section>
  )}

  <!-- Posts Grid — rendered at build time so every article is a real link -->
  <section class="py-12 px-6 bg-[#F8F7FF] min-h-[40vh]">
    <div class="max-w-5xl mx-auto">
      {posts.length === 0 ? (
        <div class="text-center py-16 text-gray-400 text-sm">אין מאמרים להצגה כרגע</div>
      ) : (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
            {posts.map((post, i) => (
              <article
                class="post-card"
                data-categories={post.categories.join(',')}
                data-new={newestIds.has(post.id) ? '1' : '0'}
                style={i >= PAGE_SIZE ? 'display:none' : undefined}
              >
                <a href={`/מאמרים/${post.slug}`} class="block text-right h-full">
                  {post.image && (
                    <img src={post.image} alt={post.title} loading="lazy"
                      style="width:100%;height:180px;object-fit:cover;border-radius:12px 12px 0 0;" />
                  )}
                  <div class="p-6">
                    <p class="text-xs text-[#6C22FF]/50 font-medium mb-3 tracking-wide">{post.dateLabel}</p>
                    <h2 class="font-black text-[#12023C] text-lg mb-3 leading-snug" style="font-family: 'Secular One', sans-serif;">{post.title}</h2>
                    <p class="text-gray-400 text-sm leading-relaxed line-clamp-3 mb-5">{post.excerpt}...</p>
                    <span class="inline-flex items-center gap-1 text-[#6C22FF] font-semibold text-sm card-arrow">
                      קרא עוד
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <!-- Pagination -->
          <div id="pagination-wrap" class="mt-10" style="display:none;">
            <div class="flex flex-wrap items-center justify-center gap-2" id="pagination-buttons"></div>
            <p class="text-center text-sm text-gray-400 mt-3" id="pagination-info"></p>
          </div>
        </>
      )}
    </div>
  </section>

</Layout>

<style is:global>
  .post-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(108, 34, 255, 0.08);
    box-shadow: 0 2px 12px rgba(18, 2, 60, 0.06);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(108, 34, 255, 0.15);
  }
  .post-card .card-arrow {
    transition: transform 0.2s ease;
  }
  .post-card:hover .card-arrow {
    transform: translateX(-4px);
  }
  .cat-btn-active {
    background: #6C22FF !important;
    color: white !important;
    border-color: #6C22FF !important;
    box-shadow: 0 4px 14px rgba(108, 34, 255, 0.3);
  }
  .cat-btn-inactive {
    background: white;
    color: #6C22FF;
    border-color: rgba(108, 34, 255, 0.3);
  }
  .cat-btn-inactive:hover {
    background: #F5F3FF;
    border-color: #6C22FF;
  }
  .page-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid rgba(108, 34, 255, 0.25);
    background: white;
    color: #6C22FF;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.18s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .page-btn:hover {
    background: #F5F3FF;
    border-color: #6C22FF;
  }
  .page-btn.active {
    background: #6C22FF;
    color: white;
    border-color: #6C22FF;
    box-shadow: 0 4px 14px rgba(108, 34, 255, 0.3);
  }
  .page-btn.arrow {
    font-size: 1.1rem;
  }
  .page-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
</style>

<script>
  // Cards are already in the HTML. This only shows/hides them —
  // every article link stays in the page for crawlers either way.
  const PAGE_SIZE = 12;

  const grid = document.getElementById('posts-grid');
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card'));
    const paginationWrap = document.getElementById('pagination-wrap')!;
    const paginationButtons = document.getElementById('pagination-buttons')!;
    const paginationInfo = document.getElementById('pagination-info')!;

    let currentPage = 1;
    let activeCat: string = 'all';

    function getFiltered() {
      if (activeCat === 'new') return cards.filter(c => c.dataset.new === '1');
      if (activeCat === 'all') return cards;
      return cards.filter(c => (c.dataset.categories ?? '').split(',').includes(activeCat));
    }

    function getPagesToShow(current: number, total: number): (number | string)[] {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const pages: (number | string)[] = [1];
      if (current > 3) pages.push('...');
      for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) pages.push(i);
      if (current < total - 2) pages.push('...');
      pages.push(total);
      return pages;
    }

    function goToPage(page: number) {
      currentPage = page;
      updateGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateGrid() {
      const filtered = getFiltered();
      const start = (currentPage - 1) * PAGE_SIZE;
      const visible = new Set(filtered.slice(start, start + PAGE_SIZE));

      cards.forEach(c => { c.style.display = visible.has(c) ? '' : 'none'; });

      const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
      if (totalPages <= 1) {
        paginationWrap.style.display = 'none';
        return;
      }

      paginationWrap.style.display = '';
      paginationInfo.textContent = `עמוד ${currentPage} מתוך ${totalPages}`;
      paginationButtons.innerHTML = '';

      // RTL: right arrow = previous
      const prevBtn = document.createElement('button');
      prevBtn.className = 'page-btn arrow';
      prevBtn.textContent = '›';
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
      paginationButtons.appendChild(prevBtn);

      getPagesToShow(currentPage, totalPages).forEach(p => {
        if (p === '...') {
          const dots = document.createElement('span');
          dots.textContent = '…';
          dots.className = 'text-gray-400 px-1';
          paginationButtons.appendChild(dots);
        } else {
          const btn = document.createElement('button');
          btn.className = `page-btn${p === currentPage ? ' active' : ''}`;
          btn.textContent = String(p);
          btn.addEventListener('click', () => goToPage(Number(p)));
          paginationButtons.appendChild(btn);
        }
      });

      const nextBtn = document.createElement('button');
      nextBtn.className = 'page-btn arrow';
      nextBtn.textContent = '‹';
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener('click', () => goToPage(currentPage + 1));
      paginationButtons.appendChild(nextBtn);
    }

    document.querySelectorAll<HTMLElement>('#cat-buttons button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cat-buttons button').forEach(b => {
          b.className = 'px-4 py-1.5 rounded-full border font-semibold text-sm transition-all cat-btn-inactive';
        });
        btn.className = 'px-4 py-1.5 rounded-full border font-semibold text-sm transition-all cat-btn-active';
        activeCat = btn.dataset.cat ?? 'all';
        currentPage = 1;
        updateGrid();
      });
    });

    updateGrid();
  }
</script>
